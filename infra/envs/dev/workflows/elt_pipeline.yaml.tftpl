# Phase 11: ELT pipeline. Rendered by Terraform templatefile():
#   double-dollar expressions -> Workflows (Terraform leaves them alone)
#   single-dollar expressions -> filled in by Terraform (the SQL files)
main:
  steps:
    - init:
        assign:
          - project: $${sys.get_env("GOOGLE_CLOUD_PROJECT_ID")}
          - location: "us-central1"

    # Each jobs.insert blocks until the MERGE succeeds or fails.
    # A failed MERGE raises an error -> the workflow stops here (later steps never run).
    - merge_asset_snapshots:
        call: googleapis.bigquery.v2.jobs.insert
        args:
          projectId: $${project}
          body:
            jobReference:
              location: $${location}
            configuration:
              query:
                query: ${sql_asset_snapshots}
                useLegacySql: false
        result: asset_job

    - merge_fx_rates:
        call: googleapis.bigquery.v2.jobs.insert
        args:
          projectId: $${project}
          body:
            jobReference:
              location: $${location}
            configuration:
              query:
                query: ${sql_fx_rates}
                useLegacySql: false
        result: fx_job

    - merge_ohlcv_1m:
        call: googleapis.bigquery.v2.jobs.insert
        args:
          projectId: $${project}
          body:
            jobReference:
              location: $${location}
            configuration:
              query:
                query: ${sql_ohlcv_1m}
                useLegacySql: false
        result: ohlcv_job

    # DQ runs AFTER the MERGEs, so freshness reflects the data just loaded.
    - run_dq:
        try:
          call: googleapis.run.v2.projects.locations.jobs.run
          args:
            name: $${"projects/" + project + "/locations/" + location + "/jobs/dq-runner"}
          result: dq_execution
        except:
          as: e
          steps:
            - dq_failed:
                raise:
                  message: "DQ checks failed: see ops.dq_results and dq-runner logs"
                  cause: $${e}

    # Belt and braces: if the connector returned normally but a task failed, still fail.
    - check_dq:
        switch:
          - condition: $${default(map.get(dq_execution, "failedCount"), 0) > 0}
            raise: "DQ checks failed: dq-runner execution reported failed tasks"

    - done:
        return:
          asset_snapshots_rows: $${default(map.get(asset_job, ["statistics", "query", "numDmlAffectedRows"]), "n/a")}
          fx_rates_rows: $${default(map.get(fx_job, ["statistics", "query", "numDmlAffectedRows"]), "n/a")}
          ohlcv_1m_rows: $${default(map.get(ohlcv_job, ["statistics", "query", "numDmlAffectedRows"]), "n/a")}